{
  "name": "tickmarkr",
  "version": "2.4.1",
  "description": "Spec in, verified work out.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "automation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alzahrani-khalid/tickmarkr.git"
  },
  "homepage": "https://github.com/alzahrani-khalid/tickmarkr",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tickmarkr": "dist/cli/index.js",
    "tkr": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "lint": "oxlint src tests scripts --format stylish",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schema": "tsx scripts/emit-schema.ts",
    "e2e": "TICKMARKR_E2E=1 vitest run tests/e2e --testTimeout 900000"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "chalk": "^5.6.2",
    "ink": "^6.8.0",
    "picomatch": "^4.0.2",
    "react": "^19.2.8",
    "string-width": "5.1.2",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/picomatch": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "oxlint": "1.74.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "tickmarkrExport": {
    "publicPaths": {
      "exact": [
        ".gitignore",
        ".oxlintrc.json",
        "CHANGELOG.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "FLEET.md",
        "LICENSE",
        "README.md",
        "RELEASING.md",
        "SECURITY.md",
        "package-lock.json",
        "package.json",
        "tickmarkr.spec.md",
        "tsconfig.json",
        "vitest.config.ts",
        ".github/pull_request_template.md",
        "scripts/assert-test-file-count.sh",
        "scripts/emit-schema.ts",
        "scripts/probe-rig.mjs",
        "specs/export-selftest.spec.md"
      ],
      "prefixes": [
        ".github/ISSUE_TEMPLATE/",
        ".github/workflows/",
        "assets/",
        "docs/codebase/",
        "fixtures/",
        "schema/",
        "skills/tickmarkr-auto/",
        "skills/tickmarkr-loop/",
        "skills/tickmarkr-overseer/",
        "src/",
        "tests/"
      ]
    },
    "excludedPaths": [
      ".planning",
      "specs",
      ".tickmarkr",
      ".overseer",
      ".claude",
      "docs",
      "ASSESSMENT-*.md",
      ".gitignore",
      "scripts/measure-trailer-width.mjs",
      "scripts/scan-scope-corpus.mjs",
      "scripts/repro-obs96.mjs",
      "CLAUDE.md",
      "scripts/export-public.sh",
      "scripts/verify-export.sh",
      "tests/scripts/verify-export.test.ts",
      ".github/workflows/ci.yml",
      "**/*.local.*"
    ]
  }
}
